# .env.example - plantilla pública sin valores reales
# Copia este archivo a .env y completa con tus datos reales (NUNCA subir .env a Git)

SECRET_KEY=cambiar-por-clave-aleatoria-segura-min-50-chars
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1
DATABASE_URL=postgres://user:password@localhost:5432/erp_db

# Celery / Redis (W16)
REDIS_URL=redis://localhost:6379/0

SENDGRID_API_KEY=SG.xxxxxxxxxxxxxxxx

STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxx
STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxx

# Opcionales para producción (S3)
AWS_ACCESS_KEY_ID=TU_ACCESS_KEY_AQUI
AWS_SECRET_ACCESS_KEY=TU_SECRET_KEY_AQUI
AWS_STORAGE_BUCKET_NAME=erp-django-media
AWS_S3_REGION_NAME=us-east-1
# W16 — Celery / Redis
# Vacía (laboratorio sin Docker): las tareas se ejecutan en modo EAGER,
# en el mismo proceso, sin Redis ni worker.
# Con Docker local:  REDIS_URL=redis://localhost:6379/0
# En Render: NO usar este archivo → REDIS_URL = Internal Key Value URL
#            y CELERY_EMBEDDED_WORKER=1 en Environment del servicio web.
REDIS_URL=